    "scan.progress.counts": {
      "comment": "Folders and files visited so far; pluralize each count independently.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count1@ · %#@count2@"
          },
          "substitutions": {
            "count1": {
              "argNum": 1,
              "formatSpecifier": "llu",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%llu folder"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%llu folders"
                    }
                  }
                }
              }
            },
            "count2": {
              "argNum": 2,
              "formatSpecifier": "llu",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%llu file"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%llu files"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "scan.rendering.limit": {
      "comment": "Warning with number of tiles omitted by the rendering budget.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
