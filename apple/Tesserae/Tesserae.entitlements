<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: whole-disk scanning is incompatible with it (spec §14).
	     Full Disk Access is a TCC grant the user makes; no entitlement grants it. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
