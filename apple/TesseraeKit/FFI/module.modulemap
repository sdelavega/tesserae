// The C module `TesseraeFFI`: the header cbindgen generates from tesserae-ffi,
// used in place (scripts/gen-header.sh keeps it current; CI fails on a diff).
// The library itself, apple/build/libtesserae.a, is linked by TesseraeKit's
// OTHER_LDFLAGS, not here, so importing this module never adds a link.
module TesseraeFFI {
    header "../../../crates/tesserae-ffi/include/tesserae.h"
    export *
}
