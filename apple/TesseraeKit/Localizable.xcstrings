{
  "sourceLanguage": "en",
  "strings": {
    "reclaim.noCompressedItems": {
      "comment": "Empty state for the recently compressed history.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No compressed items."
          }
        }
      }
    },
    "reclaim.nothingStaged": {
      "comment": "Summary when no items are staged for reclaiming space.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing staged"
          }
        }
      }
    },
    "reclaimAction.appBundleCompress": {
      "comment": "Warning before compressing an app bundle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contents are unchanged; Tesserae re-checks the signature afterwards."
          }
        }
      }
    },
    "reclaimAction.cannotCompress": {
      "comment": "Disabled in-place compression on an unsupported volume.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This disk can't compress files in place. Archive instead?"
          }
        }
      }
    },
    "reclaimAction.containsOtherVolume": {
      "comment": "Archive denial for a nested volume.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item contains another volume's mount point and can't be archived."
          }
        }
      }
    },
    "reclaimAction.gitWorkingTree": {
      "comment": "Warning before compressing a Git working tree.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "git status may be slow once."
          }
        }
      }
    },
    "reclaimAction.isArchive": {
      "comment": "Archive denial for an archive item.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item is already an archive in a supported format."
          }
        }
      }
    },
    "reclaimAction.largeCompressRun": {
      "comment": "Warning for a large compression run.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than 100 GB is eligible for compression."
          }
        }
      }
    },
    "reclaimAction.largeFile": {
      "comment": "Compression warning for a file larger than 4 GiB.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file can't be interrupted mid-file."
          }
        }
      }
    },
    "reclaimAction.parentNotWritable": {
      "comment": "Archive must be created beside the original item.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item's parent folder isn't writable."
          }
        }
      }
    },
    "reclaimAction.readOnly": {
      "comment": "Disabled action on a read-only volume.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This disk is read-only."
          }
        }
      }
    },
    "compressSkip.notRegular": {
      "comment": "Why a file is excluded from in-place compression: notRegular.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a regular file."
          }
        }
      }
    },
    "compressSkip.alreadyCompressed": {
      "comment": "Why a file is excluded from in-place compression: alreadyCompressed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already compressed."
          }
        }
      }
    },
    "compressSkip.hardLinked": {
      "comment": "Why a file is excluded from in-place compression: hardLinked.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard-linked file."
          }
        }
      }
    },
    "compressSkip.sparse": {
      "comment": "Why a file is excluded from in-place compression: sparse.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparse file; compression would materialise it."
          }
        }
      }
    },
    "compressSkip.cloudOnly": {
      "comment": "Why a file is excluded from in-place compression: cloudOnly.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-only file; reading would download it."
          }
        }
      }
    },
    "compressSkip.resourceFork": {
      "comment": "Why a file is excluded from in-place compression: resourceFork.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has a non-empty resource fork."
          }
        }
      }
    },
    "compressSkip.empty": {
      "comment": "Why a file is excluded from in-place compression: empty.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty file."
          }
        }
      }
    },
    "compressSkip.wontShrink": {
      "comment": "Why a file is excluded from in-place compression: wontShrink.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file type is unlikely to shrink."
          }
        }
      }
    },
    "compressSkip.liveDatabase": {
      "comment": "Why a file is excluded from in-place compression: liveDatabase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live database or database with a journal sidecar."
          }
        }
      }
    },
    "compressSkip.vmImage": {
      "comment": "Why a file is excluded from in-place compression: vmImage.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual machine or disk image."
          }
        }
      }
    },
    "compressSkip.cloudSync": {
      "comment": "Why a file is excluded from in-place compression: cloudSync.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside a cloud-sync folder."
          }
        }
      }
    },
    "compressSkip.storeOrAdobeApp": {
      "comment": "Why a file is excluded from in-place compression: storeOrAdobeApp.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside a Store or Adobe app."
          }
        }
      }
    },
    "compressSkip.openForWriting": {
      "comment": "Why a file is excluded from in-place compression: openForWriting.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open for writing."
          }
        }
      }
    },
    "compressSkip.notWritable": {
      "comment": "Why a file is excluded from in-place compression: notWritable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file or its directory isn't writable."
          }
        }
      }
    },
    "reclaimAction.partialOpenFiles": {
      "comment": "Best-effort open-file inspection warning in compression review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
