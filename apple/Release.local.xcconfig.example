// Copy to Release.local.xcconfig (git-ignored) and replace these placeholders.
DEVELOPMENT_TEAM = TEAMID
// Prefer a certificate SHA-1, especially when names are duplicated.
CODE_SIGN_IDENTITY = REPLACE_WITH_40_HEX_CERTIFICATE_SHA1
// A unique full name is also accepted: Developer ID Application: YOUR NAME (TEAMID)
NOTARY_PROFILE = notarytool
