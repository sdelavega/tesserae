// Local Release builds sign ad-hoc; the release pipeline requires the local file.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = YES
OTHER_CODE_SIGN_FLAGS = $(inherited) --timestamp
// scripts/bundle-version.sh 0.1.0; release.sh passes the derivation on the command line.
CURRENT_PROJECT_VERSION = 100
#include? "Release.local.xcconfig"
